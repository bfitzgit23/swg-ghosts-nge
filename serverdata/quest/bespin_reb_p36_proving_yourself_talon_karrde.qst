                                <data value="0.0" name="EntranceLocationZ(m)" />
                                <data value="" name="entranceWaypointName" />
                                <data value="I saw your meeting with Karrde on the security cameras. I know you want my implant but it has a strict 'no detachment' policy. You're not getting it. If you keep searching for me, you die. Turn back now." name="Comm Message Text" />
                                <data value="object/mobile/bespin/reb_io.iff" name="NPC Appearance Server Template" />
                                <task type="Show Message Box" id="5" taskOnFail="false" >
                                    <data value="Find Io" name="journalEntryTitle" />
                                    <data value="&quot;With the droids no longer a concern, you take the time to look around Mine 017 in the hopes of finding a clue as to Io's current location. If Io reprogrammed the security droids that ambushed you, there may be some clue in the droids' computer logs that will help you track her down. Perhaps a signal trace indicating where the signal Io sent to reprogram the droids originated from. Or maybe a DNA fragment left on the droids to scan for if she reprogrammed them in person.With a plan in mind, you pick up one of the droids' chassis. Head to the Abandoned Industrial Sector and use the equipment in the Droid Maintenance Centre there to analyse it.&quot;" name="journalEntryDescription" />
                                    <data value="true" name="isVisible" />
                                    <data value="" name="prerequisiteTasks" />
                                    <data value="" name="exclusionTasks" />
                                    <data value="0" name="allowRepeats" />
                                    <data value="io_mess" name="taskName" />
