                            <task type="Comm Player" id="4" taskOnFail="false" >
                                <data value="Comm. from Io" name="journalEntryTitle" />
                                <data value="Comm. from Io: &quot;I saw your meeting with Karrde on the security cameras. I know you want my implant but it has a strict 'no detachment' policy. You're not getting it. If you keep searching for me, you die. Turn back now.&quot;" name="journalEntryDescription" />
                                <data value="true" name="isVisible" />
